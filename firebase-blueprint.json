{
  "entities": {
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "A secure offline-first journal entry synced to the cloud.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "title": { "type": "string" },
        "transcript": { "type": "string" },
        "audioDuration": { "type": "number" },
        "audioUrl": { "type": "string" },
        "fileSize": { "type": "number" },
        "moodScore": { "type": "number" },
        "moodLabel": { "type": "string" },
        "emotionLabel": { "type": "string" },
        "insightsSummary": { "type": "string" },
        "aiProcessingStatus": { "type": "string" },
        "categories": { "type": "array" },
        "tags": { "type": "array" },
        "colorTags": { "type": "array" },
        "location": { "type": "string" },
        "favorite": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "wordCount": { "type": "number" },
        "language": { "type": "string" },
        "syncStatus": { "type": "string" },
        "encryptionStatus": { "type": "string" },
        "versionNumber": { "type": "number" },
        "metadata": { "type": "object" },
        "folderId": { "type": "string" }
      },
      "required": ["id", "userId", "createdAt", "transcript"]
    },
    "SyncQueueItem": {
      "title": "SyncQueueItem",
      "description": "An offline sync queue item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entryId": { "type": "string" },
        "action": { "type": "string" },
        "payload": { "type": "object" },
        "createdAt": { "type": "string" },
        "attempts": { "type": "number" }
      },
      "required": ["id", "entryId", "action", "payload", "createdAt", "attempts"]
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "An encrypted user backup metadata record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "recordCount": { "type": "number" },
        "schemaVersion": { "type": "number" }
      },
      "required": ["id", "userId", "createdAt", "recordCount"]
    },
    "TrustedDevice": {
      "title": "TrustedDevice",
      "description": "A recognized device in the user sanctuary.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "An immutable access audit event.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "userId", "timestamp", "action", "details"]
    }
  },
  "firestore": {
    "users/{userId}/journal_entries/{id}": {
      "schema": "JournalEntry",
      "description": "User journal entries"
    },
    "users/{userId}/sync_queue/{id}": {
      "schema": "SyncQueueItem",
      "description": "User offline sync queue"
    },
    "users/{userId}/backups/{id}": {
      "schema": "BackupSnapshot",
      "description": "Encrypted user backup metadata snapshots"
    },
    "users/{userId}/devices/{id}": {
      "schema": "TrustedDevice",
      "description": "Recognized trusted user devices"
    },
    "users/{userId}/audit_logs/{id}": {
      "schema": "AuditLog",
      "description": "Immutable security and audit trace records"
    }
  }
}
